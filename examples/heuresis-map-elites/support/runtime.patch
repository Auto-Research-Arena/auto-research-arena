 _HF_CACHE_SANDBOX = "/tmp/huggingface"
+
+_FRESH_PROC_OK: bool | None = None
+
+
+def _can_mount_fresh_proc() -> bool:
+    """Check whether bwrap can mount procfs in a new PID namespace."""
+    global _FRESH_PROC_OK
+    if _FRESH_PROC_OK is None:
+        try:
+            _FRESH_PROC_OK = subprocess.run(
+                ["bwrap", "--ro-bind", "/usr", "/usr", "--unshare-pid",
+                 "--proc", "/proc", "--", "/bin/true"],
+                capture_output=True, timeout=30).returncode == 0
+        except (OSError, subprocess.SubprocessError):
+            _FRESH_PROC_OK = False
+        if not _FRESH_PROC_OK:
+            print("WARN: bwrap cannot mount a fresh /proc under --unshare-pid on "
+                  "this host (masked /proc overmounts), so --unshare-pid is "
+                  "DROPPED and the sandbox runs in the host PID namespace.",
+                  flush=True)
+    return _FRESH_PROC_OK
+
+
+def _cuda_index_to_device_minor() -> dict[int, int]:
+    """Match CUDA indices to device minors by PCI bus address."""
+    try:
+        out = subprocess.run(
+            ["nvidia-smi", "--query-gpu=index,pci.bus_id",
+             "--format=csv,noheader,nounits"],
+            capture_output=True, text=True, timeout=15, check=True).stdout
+    except (OSError, subprocess.SubprocessError):
+        return {}
+
+    def _norm(bus: str) -> str:
+        parts = bus.strip().lower().split(":")
+        return ":".join(parts[-2:]) if len(parts) >= 2 else bus.strip().lower()
+
+    minor_by_bus: dict[str, int] = {}
+    for info in Path("/proc/driver/nvidia/gpus").glob("*/information"):
+        try:
+            text = info.read_text()
+        except OSError:
+            continue
+        for line in text.splitlines():
+            if "Device Minor" in line:
+                try:
+                    minor_by_bus[_norm(info.parent.name)] = int(
+                        line.split(":", 1)[1].strip())
+                except (IndexError, ValueError):
+                    pass
+    mapping: dict[int, int] = {}
+    for line in out.strip().splitlines():
+        if "," not in line:
+            continue
+        idx_s, bus = (p.strip() for p in line.split(",", 1))
+        try:
+            idx = int(idx_s)
+        except ValueError:
+            continue
+        m = minor_by_bus.get(_norm(bus))
+        if m is not None:
+            mapping[idx] = m
+    return mapping
 
 
